# Port the HTTP server listens on.
PORT=3610

# Required. Bearer token for the /admin/* API (issue/list/revoke API keys that raise
# the plan used when creating a project). Must be at least 16 characters.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-value

# Where the SQLite database file lives.
DB_PATH=./data/mock-api.db

# Base URL this instance is reachable at (used to build baseUrl/manageUrl in API responses).
PUBLIC_URL=http://localhost:3610

# Set to "1" only when running behind a reverse proxy you control, so that
# X-Forwarded-For is trusted for client IPs (rate limiting). Leave "0" otherwise.
TRUST_PROXY=0

# Hard ceiling on concurrently live projects (anti-abuse / disk protection).
MAX_PROJECTS=5000
